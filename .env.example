# Pero 环境变量名称示例；所有凭据均留空。
# 程序不会仅因存在此文件就自动加载它。请在启动进程中实际设置环境变量，
# 或使用 README 所述启动器及控制室；不要把真实值提交到仓库。

# 服务监听；启动器还会读取运行配置，详见 docs/local-launcher.md。
PERO_HOST=127.0.0.1
PERO_PORT=8765

# 可选运行配置文件，路径按部署环境填写。
# PERO_CONFIG_FILE=

# 可选：指定管理访问码；不设置时 Windows 启动器会自动生成并加密保存。
PERO_MANAGEMENT_TOKEN=

# 模型 Key 也可以通过控制室托管，不要求写入环境文件。
PERO_DEEPSEEK_API_KEY=

# 桥连接令牌，与模型 Key 和管理访问码不同。
PERO_ONEBOT_TOKEN=

# 可选：嵌入服务凭据。Ollama 本地嵌入按对应配置使用。
PERO_EMBEDDING_API_KEY=
